<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Border.Strong}"/>
        <Setter Property="Width" Value="10"/>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
</ResourceDictionary>
