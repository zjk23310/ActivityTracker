<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:ActivityTracker"
                    xmlns:views="clr-namespace:ActivityTracker.Views"
                    xmlns:dev="clr-namespace:ActivityTracker.Views.Dev">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Typography.xaml"/>
        <ResourceDictionary Source="Metrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Canvas}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    </Style>
    <Style TargetType="UserControl">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Canvas}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.Body}"/>
    </Style>
    <!-- WPF 的隐式样式按具体运行时类型查找；为本项目的派生窗口/视图接上基类主题。 -->
    <Style TargetType="{x:Type app:MainWindow}" BasedOn="{StaticResource {x:Type Window}}"/>
    <Style TargetType="{x:Type views:AddTodoDialog}" BasedOn="{StaticResource {x:Type Window}}"/>
    <Style TargetType="{x:Type dev:StyleGalleryWindow}" BasedOn="{StaticResource {x:Type Window}}"/>
    <Style TargetType="{x:Type views:StatisticsView}" BasedOn="{StaticResource {x:Type UserControl}}"/>
    <Style TargetType="{x:Type views:DiaryTodoView}" BasedOn="{StaticResource {x:Type UserControl}}"/>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Stroke.Thin}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
        <Setter Property="Padding" Value="{StaticResource Card.Padding}"/>
    </Style>
    <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="MinWidth" Value="180"/>
        <Setter Property="MinHeight" Value="112"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
    </Style>
    <Style x:Key="ActivityRow" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Row.Height}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.SurfaceHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CurrentActivityHero" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Muted}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Lg}"/>
        <Setter Property="MinHeight" Value="128"/>
    </Style>
    <Style x:Key="StatusPresenceCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>
    <Style x:Key="FocusRing" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Ring}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Md}"/>
    </Style>
</ResourceDictionary>
