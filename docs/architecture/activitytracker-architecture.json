  "cards": [
    {
      "dot": "cyan",
      "title": "后台守护形态",
      "items": [
        "追踪生命周期由 Generic Host 管理，与窗口显示状态解耦。",
        "重复启动通过 Mutex 与命名管道唤醒现有窗口。"
      ]
    },
    {
      "dot": "emerald",
      "title": "可靠数据链路",
      "items": [
        "SessionTracker 发布不可变活动快照，数据库订阅完整有序消费。",
        "关闭快照具有终局性，退出前排空事件并执行 WAL checkpoint。"
      ]
    },
    {
      "dot": "violet",
      "title": "展示与扩展",
      "items": [
        "StatisticsService 按逻辑 AppId 聚合，同时兼容没有 AppId 的历史记录。",
        "UI 与 Presence 使用最新值通道，慢消费者不会阻塞核心追踪。"
      ]
    }
  ]
