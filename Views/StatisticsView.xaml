<UserControl x:Class="ActivityTracker.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="18">

        <Grid.RowDefinitions>

            <!-- 标题 -->
            <RowDefinition Height="Auto"/>

            <!-- 快捷时间选择 -->
            <RowDefinition Height="Auto"/>

            <!-- 自定义日期 -->
            <RowDefinition Height="Auto"/>

            <!-- 汇总 -->
            <RowDefinition Height="Auto"/>

            <!-- 表格 -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- 标题 -->
        <!-- ========================= -->

        <TextBlock Grid.Row="0"
                   Text="使用统计"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Margin="0,0,0,18"/>


        <!-- ========================= -->
        <!-- 快捷时间范围 -->
        <!-- ========================= -->

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">

            <Button Content="今日"
                    Width="80"
                    Click="Today_Click"/>

            <Button Content="近7天"
                    Width="80"
                    Margin="8,0,0,0"
                    Click="SevenDays_Click"/>

            <Button Content="近30天"
                    Width="80"
                    Margin="8,0,0,0"
                    Click="ThirtyDays_Click"/>

            <Button Content="本月"
                    Width="80"
                    Margin="8,0,0,0"
                    Click="ThisMonth_Click"/>

            <Button Content="今年"
                    Width="80"
                    Margin="8,0,0,0"
                    Click="ThisYear_Click"/>

            <Button Content="刷新"
                    Width="80"
                    Margin="20,0,0,0"
                    Click="Refresh_Click"/>

        </StackPanel>


        <!-- ========================= -->
        <!-- 日期范围 -->
        <!-- ========================= -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,16,0,16">

            <TextBlock Text="开始日期"
                       VerticalAlignment="Center"/>

            <DatePicker x:Name="StartDatePicker"
                        Width="140"
                        Margin="10,0,20,0"/>

            <TextBlock Text="结束日期"
                       VerticalAlignment="Center"/>

            <DatePicker x:Name="EndDatePicker"
                        Width="140"
                        Margin="10,0,20,0"/>

            <Button Content="查询"
                    Width="80"
                    Click="CustomRange_Click"/>

        </StackPanel>


        <!-- ========================= -->
        <!-- 汇总 -->
        <!-- ========================= -->

        <Border Grid.Row="3"
                Padding="12"
                Margin="0,0,0,14"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

            <TextBlock x:Name="StatisticsSummary"
                       FontSize="16"
                       Text="暂无统计数据"/>

        </Border>


        <!-- ========================= -->
        <!-- 应用统计 -->
        <!-- ========================= -->

        <DataGrid Grid.Row="4"
                  x:Name="StatisticsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="应用"
                    Binding="{Binding ProcessName}"
                    Width="180"/>

                <DataGridTextColumn
                    Header="使用时长"
                    Binding="{Binding DurationText}"
                    Width="130"/>

                <DataGridTextColumn
                    Header="使用片段"
                    Binding="{Binding SessionCount}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="可执行文件"
                    Binding="{Binding ExecutablePath}"
                    Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>