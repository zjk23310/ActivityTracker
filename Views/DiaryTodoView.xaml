<UserControl x:Class="ActivityTracker.Views.DiaryTodoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ActivityTracker.Views">

    <UserControl.Resources>
        <local:BoolToTextDecorationConverter
            x:Key="BoolToTextDecoration"/>
        <local:EmptyStringToCollapsedConverter
            x:Key="EmptyToCollapsed"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Padding="18">

        <StackPanel>

            <!-- ========================= -->
            <!-- 标题 + 日期选择 -->
            <!-- ========================= -->

            <TextBlock Text="日记与待办"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,18">

                <TextBlock Text="选择日期"
                           VerticalAlignment="Center"/>

                <DatePicker x:Name="DatePicker"
                            Width="170"
                            Margin="10,0,0,0"
                            SelectedDateChanged="DatePicker_SelectedDateChanged"/>

            </StackPanel>

            <!-- ========================= -->
            <!-- 日记 -->
            <!-- ========================= -->

            <Border Padding="14"
                    Margin="0,0,0,18"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                <StackPanel>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="日记"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="保存"
                                Width="70"
                                HorizontalAlignment="Right"
                                Click="SaveDiary_Click"/>
                    </Grid>

                    <!-- 标题 + 心情 -->
                    <Grid Margin="0,0,0,8">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="标题"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox Grid.Column="1"
                                 x:Name="DiaryTitleBox"
                                 MaxLength="100"/>

                        <TextBlock Grid.Column="2"
                                   Text="心情"
                                   VerticalAlignment="Center"
                                   Margin="16,0,8,0"/>

                        <!-- 索引 0 = 未记录，1-5 对应心情分值 -->
                        <ComboBox Grid.Column="3"
                                  x:Name="MoodBox"
                                  Width="90"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="未记录"/>
                            <ComboBoxItem Content="很差"/>
                            <ComboBoxItem Content="较差"/>
                            <ComboBoxItem Content="一般"/>
                            <ComboBoxItem Content="不错"/>
                            <ComboBoxItem Content="很好"/>
                        </ComboBox>

                    </Grid>

                    <!-- 正文 -->
                    <TextBox x:Name="DiaryTextBox"
                             MinHeight="150"
                             FontSize="14"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxLength="5000"/>

                    <!-- 标签 -->
                    <Grid Margin="0,8,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="标签"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <TextBox Grid.Column="1"
                                 x:Name="DiaryTagsBox"
                                 MaxLength="100"/>

                        <TextBlock Grid.Column="2"
                                   Text="多个用逗号分隔"
                                   Foreground="#999999"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>

                    </Grid>

                </StackPanel>

            </Border>

            <!-- ========================= -->
            <!-- 待办事项 -->
            <!-- ========================= -->

            <Border Padding="14"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                <StackPanel>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="待办事项"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="添加待办"
                                Width="90"
                                HorizontalAlignment="Right"
                                Click="AddTodo_Click"/>
                    </Grid>

                    <!-- 待办列表 -->
                    <ItemsControl x:Name="TodoList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6"
                                        Margin="0,0,0,4"
                                        Background="#F8F8F8"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsCompleted}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"
                                                  Click="TodoCheckBox_Click"/>

                                        <StackPanel Grid.Column="1">

                                            <!-- 优先级标记 + 标题 -->
                                            <StackPanel Orientation="Horizontal">

                                                <Border Background="#FDE7E7"
                                                        CornerRadius="3"
                                                        Padding="5,1"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding PriorityText,
                                                            Converter={StaticResource EmptyToCollapsed}}">
                                                    <TextBlock Text="{Binding PriorityText}"
                                                               Foreground="#C00000"
                                                               FontSize="11"/>
                                                </Border>

                                                <TextBlock Text="{Binding Title}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextDecorations="{Binding IsCompleted,
                                                                Converter={StaticResource BoolToTextDecoration}}"/>

                                            </StackPanel>

                                            <!-- 分类 · 时刻 · 备注 -->
                                            <TextBlock Text="{Binding DetailText}"
                                                       Foreground="#888888"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding DetailText,
                                                           Converter={StaticResource EmptyToCollapsed}}"/>

                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="删除"
                                                FontSize="11"
                                                Foreground="Red"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                VerticalAlignment="Top"
                                                Click="DeleteTodo_Click"
                                                Tag="{Binding Id}"/>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 待办为空时的提示 -->
                    <TextBlock x:Name="NoTodoHint"
                               Text="暂无待办事项"
                               Foreground="#999999"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Visibility="Visible"/>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
