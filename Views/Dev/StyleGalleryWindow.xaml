<Window x:Class="ActivityTracker.Views.Dev.StyleGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ActivityTracker Design System"
        Width="1180"
        Height="820"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Page.Padding}">
            <TextBlock Text="Design System v0" Style="{StaticResource Text.Display}"/>
            <TextBlock Text="颜色、排版、间距、圆角、组件和六种交互状态"
                       Style="{StaticResource Text.Secondary}"
                       Margin="0,4,0,24"/>

            <TextBlock Text="颜色令牌" FontSize="{StaticResource Size.H2}" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,12,0,24">
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Bg.Canvas}" Width="150" Margin="0,0,8,8"><TextBlock Text="Bg.Canvas"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Bg.Surface}" Width="150" Margin="0,0,8,8"><TextBlock Text="Bg.Surface"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Bg.SurfaceHover}" Width="150" Margin="0,0,8,8"><TextBlock Text="SurfaceHover"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Bg.Sunken}" Width="150" Margin="0,0,8,8"><TextBlock Text="Bg.Sunken"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Border.Subtle}" Width="150" Margin="0,0,8,8"><TextBlock Text="Border.Subtle"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Border.Strong}" Width="150" Margin="0,0,8,8"><TextBlock Text="Border.Strong"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Text.Primary}" Width="150" Margin="0,0,8,8"><TextBlock Text="Text.Primary" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Text.Secondary}" Width="150" Margin="0,0,8,8"><TextBlock Text="Text.Secondary" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Text.Tertiary}" Width="150" Margin="0,0,8,8"><TextBlock Text="Text.Tertiary" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Text.OnAccent}" Width="150" Margin="0,0,8,8"><TextBlock Text="Text.OnAccent" Foreground="{DynamicResource Brush.Text.Primary}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Focus.Ring}" Width="150" Margin="0,0,8,8"><TextBlock Text="Focus.Ring" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Accent}" Width="150" Margin="0,0,8,8"><TextBlock Text="Accent" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Accent.Hover}" Width="150" Margin="0,0,8,8"><TextBlock Text="Accent.Hover" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Accent.Pressed}" Width="150" Margin="0,0,8,8"><TextBlock Text="Accent.Pressed" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Accent.Muted}" Width="150" Margin="0,0,8,8"><TextBlock Text="Accent.Muted"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.State.Success}" Width="150" Margin="0,0,8,8"><TextBlock Text="Success" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.State.Warning}" Width="150" Margin="0,0,8,8"><TextBlock Text="Warning" Foreground="{DynamicResource Brush.Text.OnAccent}"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.State.Danger}" Width="150" Margin="0,0,8,8"><TextBlock Text="Danger"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.State.DangerMuted}" Width="150" Margin="0,0,8,8"><TextBlock Text="Danger 20%"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.State.Idle}" Width="150" Margin="0,0,8,8"><TextBlock Text="Idle"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.1}" Width="70" Margin="0,0,8,8"><TextBlock Text="C1"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.2}" Width="70" Margin="0,0,8,8"><TextBlock Text="C2"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.3}" Width="70" Margin="0,0,8,8"><TextBlock Text="C3"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.4}" Width="70" Margin="0,0,8,8"><TextBlock Text="C4"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.5}" Width="70" Margin="0,0,8,8"><TextBlock Text="C5"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.6}" Width="70" Margin="0,0,8,8"><TextBlock Text="C6"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.7}" Width="70" Margin="0,0,8,8"><TextBlock Text="C7"/></Border>
                <Border Style="{StaticResource Card}" Background="{DynamicResource Chart.8}" Width="70" Margin="0,0,8,8"><TextBlock Text="C8"/></Border>
            </WrapPanel>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="排版" FontSize="{StaticResource Size.H2}" FontWeight="SemiBold"/>
                    <TextBlock Text="Display 32" FontFamily="{StaticResource Font.Display}" FontSize="{StaticResource Size.Display}"/>
                    <TextBlock Text="Heading 1 / 24" FontSize="{StaticResource Size.H1}"/>
                    <TextBlock Text="Heading 2 / 18" FontSize="{StaticResource Size.H2}"/>
                    <TextBlock Text="Body / 13　计时 01:23:45" FontSize="{StaticResource Size.Body}" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="Caption / 11" FontSize="{StaticResource Size.Caption}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="间距与圆角" FontSize="{StaticResource Size.H2}" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                        <Border Width="{StaticResource Space.1}" Height="20" Background="{DynamicResource Chart.1}" Margin="0,0,4,0"/>
                        <Border Width="{StaticResource Space.2}" Height="20" Background="{DynamicResource Chart.2}" Margin="0,0,4,0"/>
                        <Border Width="{StaticResource Space.3}" Height="20" Background="{DynamicResource Chart.3}" Margin="0,0,4,0"/>
                        <Border Width="{StaticResource Space.4}" Height="20" Background="{DynamicResource Chart.4}" Margin="0,0,4,0"/>
                        <Border Width="{StaticResource Space.5}" Height="20" Background="{DynamicResource Chart.5}" Margin="0,0,4,0"/>
                        <Border Width="{StaticResource Space.6}" Height="20" Background="{DynamicResource Chart.6}" Margin="0,0,4,0"/>
                        <Border Width="{StaticResource Space.7}" Height="20" Background="{DynamicResource Chart.7}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="80" Height="48" CornerRadius="{StaticResource Radius.Sm}" Background="{DynamicResource Brush.Bg.SurfaceHover}" Margin="0,0,8,0"/>
                        <Border Width="80" Height="48" CornerRadius="{StaticResource Radius.Md}" Background="{DynamicResource Brush.Bg.SurfaceHover}" Margin="0,0,8,0"/>
                        <Border Width="80" Height="48" CornerRadius="{StaticResource Radius.Lg}" Background="{DynamicResource Brush.Bg.SurfaceHover}" Margin="0,0,8,0"/>
                        <Border Width="80" Height="48" CornerRadius="{StaticResource Radius.Pill}" Background="{DynamicResource Brush.Bg.SurfaceHover}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="组件蓝图" FontSize="{StaticResource Size.H2}" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,12,0,24">
                <Border Style="{StaticResource StatTile}" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="9 小时 51 分钟" FontSize="{StaticResource Size.H1}"/><TextBlock Text="StatTile · 总使用时长" Style="{StaticResource Text.Secondary}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource CurrentActivityHero}" Width="300" Margin="0,0,12,12">
                    <StackPanel><TextBlock Text="CurrentActivityHero" Style="{StaticResource Text.Secondary}"/><TextBlock Text="正在使用 Visual Studio" FontSize="{StaticResource Size.H2}"/><TextBlock Text="00:42:17" FontSize="{StaticResource Size.Display}" Typography.NumeralAlignment="Tabular"/></StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPresenceCard}" Margin="0,0,12,12" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.State.Success}" Margin="0,0,8,0"/><TextBlock Text="正在使用 Visual Studio"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="UsageBar · 40%"/>
                        <ProgressBar Style="{StaticResource UsageBar}" Value="40" Maximum="100" Margin="0,8,0,16"/>
                        <TextBlock Text="Timeline · 24h 当前刻度"/>
                        <ProgressBar Style="{StaticResource Timeline}" Value="62" Maximum="100" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Width="360" Margin="0,0,12,12">
                    <StackPanel>
                        <Border Style="{StaticResource ActivityRow}"><Grid><Ellipse Width="8" Height="8" Fill="{DynamicResource Chart.1}" HorizontalAlignment="Left"/><TextBlock Text="Visual Studio" Margin="18,0,80,0" VerticalAlignment="Center"/><TextBlock Text="2:14:08" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/></Grid></Border>
                        <TextBlock Text="暂无活动数据" Style="{StaticResource EmptyState}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FocusRing}" Width="220" Height="52" Margin="0,0,12,12"><TextBlock Text="FocusRing · 2px / offset 1" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </WrapPanel>

            <TextBlock Text="六态" FontSize="{StaticResource Size.H2}" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,12,0,24">
                <Button Content="Normal" Width="120" Margin="0,0,8,8"/>
                <Button Content="Hover" Width="120" Margin="0,0,8,8" Background="{DynamicResource Brush.Accent.Hover}"/>
                <Button Content="Pressed" Width="120" Margin="0,0,8,8" Background="{DynamicResource Brush.Accent.Pressed}"/>
                <Button Content="Disabled" Width="120" Margin="0,0,8,8" IsEnabled="False"/>
                <Border Style="{StaticResource FocusRing}" Margin="0,0,8,8"><Button Content="Focus" Width="120"/></Border>
                <ListBox Width="140" Height="48" SelectedIndex="0" Margin="0,0,8,8"><ListBoxItem Content="Selected"/></ListBox>
            </WrapPanel>

            <TextBlock Text="输入控件" FontSize="{StaticResource Size.H2}" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,12,0,24">
                <TextBox Text="TextBox" Width="180" Margin="0,0,8,8"/>
                <ComboBox Width="180" SelectedIndex="0" Margin="0,0,8,8"><ComboBoxItem Content="ComboBox"/><ComboBoxItem Content="第二项"/></ComboBox>
                <CheckBox Content="CheckBox" IsChecked="True" Margin="8"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
